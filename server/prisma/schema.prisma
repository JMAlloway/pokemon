generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String         @id @default(uuid()) @db.Uuid
  username           String         @unique @db.VarChar(100)
  email              String         @unique
  password           String
  createdAt          DateTime       @default(now())
  lastActiveAt       DateTime       @default(now())
  // Notification settings
  discordWebhookUrl  String?        @db.Text
  telegramBotToken   String?        @db.VarChar(255)
  telegramChatId     String?        @db.VarChar(100)
  savedListings      SavedListing[]
  searchQueries      SearchQuery[]
  chaseLists         ChaseList[]
  snipeAlerts        SnipeAlert[]
}

model SearchQuery {
  id                    String          @id @default(uuid()) @db.Uuid
  userId                String          @db.Uuid
  cardName              String          @db.VarChar(255)
  set                   String?         @db.VarChar(100)
  rarity                Rarity?
  condition             Condition?
  searchFrequency       SearchFrequency @default(manual)
  priceThresholdPercent Decimal?        @db.Decimal(5, 2)
  recencyScoringEnabled Boolean         @default(true)
  lastExecutedAt        DateTime?
  createdAt             DateTime        @default(now())
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebayListings          EbayListing[]
  backgroundJobLogs     BackgroundJobLog[]

  @@index([userId])
  @@index([searchFrequency])
}

model EbayListing {
  id                  String        @id @default(uuid()) @db.Uuid
  ebayListingId       String
  searchQueryId       String        @db.Uuid
  cardName            String        @db.VarChar(255)
  listingTitle        String        @db.VarChar(500)
  currentPrice        Decimal       @db.Decimal(10, 2)
  recentSoldPrice     Decimal?      @db.Decimal(10, 2)
  priceGapPercent     Decimal?      @db.Decimal(10, 2)
  hasTypo             Boolean       @default(false)
  typoDetails         String?       @db.Text
  typoConfidenceScore Decimal?      @db.Decimal(5, 2)
  dealScore           Int?          @db.SmallInt
  recencyScore        Decimal?      @db.Decimal(5, 2)
  sellerName          String?       @db.VarChar(255)
  sellerRating        Decimal?      @db.Decimal(3, 1)
  sellerFeedbackPercent Decimal?    @db.Decimal(5, 2)
  listingUrl          String
  images              String[]
  description         String?       @db.Text
  condition           String?       @db.VarChar(50)
  buyingOption        BuyingOption  @default(FIXED_PRICE)
  bidCount            Int?          @db.SmallInt
  currentBidPrice     Decimal?      @db.Decimal(10, 2)
  auctionEndDate      DateTime?
  shippingCost        Decimal?      @db.Decimal(10, 2)
  shippingEstimated   Boolean       @default(false)
  acceptsBestOffer    Boolean       @default(false)
  listingStatus       ListingStatus @default(active)
  createdAt           DateTime      @default(now())
  lastCheckedAt       DateTime      @default(now())
  soldAt              DateTime?
  searchQuery         SearchQuery   @relation(fields: [searchQueryId], references: [id], onDelete: Cascade)
  savedListing        SavedListing?

  @@unique([searchQueryId, ebayListingId])
  @@index([searchQueryId])
  @@index([ebayListingId])
  @@index([listingStatus])
  @@index([dealScore(sort: Desc)])
  @@index([buyingOption])
}

model SavedListing {
  id                   String        @id @default(uuid()) @db.Uuid
  userId               String        @db.Uuid
  listingId            String        @unique @db.Uuid
  ebayListingId        String
  priceAtSave          Decimal       @db.Decimal(10, 2)
  recentSoldPriceAtSave Decimal?     @db.Decimal(10, 2)
  dealScoreAtSave      Int?          @db.SmallInt
  savedAt              DateTime      @default(now())
  currentPrice         Decimal?      @db.Decimal(10, 2)
  priceChangePercent   Decimal?      @db.Decimal(6, 2)
  status               ListingStatus @default(active)
  lastPriceCheckAt     DateTime?
  // Portfolio tracking fields
  purchased            Boolean       @default(false)
  purchasePrice        Decimal?      @db.Decimal(10, 2)
  purchasedAt          DateTime?
  soldPrice            Decimal?      @db.Decimal(10, 2)
  soldAt               DateTime?
  platformFees         Decimal?      @db.Decimal(10, 2)
  shippingPaid         Decimal?      @db.Decimal(10, 2)
  notes                String?       @db.Text
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebayListing          EbayListing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, ebayListingId])
  @@index([userId])
  @@index([ebayListingId])
  @@index([status])
  @@index([listingId])
  @@index([purchased])
}

model RecentSoldListing {
  id            String   @id @default(uuid()) @db.Uuid
  cardName      String   @db.VarChar(255)
  set           String?  @db.VarChar(100)
  rarity        String?  @db.VarChar(50)
  condition     String?  @db.VarChar(50)
  soldPrice     Decimal  @db.Decimal(10, 2)
  shippingCost  Decimal? @db.Decimal(10, 2)
  soldAt        DateTime
  daysOld       Int?     @db.SmallInt
  source        String   @default("eBay") @db.VarChar(50)
  ebayItemId    String?  @db.VarChar(100)
  ebayUrl       String?  @db.Text
  listingTitle  String?  @db.Text
  lastUpdatedAt DateTime @default(now())

  @@index([cardName])
  @@index([soldAt])
}

model SellerProfile {
  id                    String   @id @default(uuid()) @db.Uuid
  sellerName            String   @unique @db.VarChar(255)
  totalListingsSeen     Int      @default(0)
  dealsCount            Int      @default(0)
  typosCount            Int      @default(0)
  avgDealScore          Decimal? @db.Decimal(5, 2)
  avgPriceGapPercent    Decimal? @db.Decimal(6, 2)
  lastSeenAt            DateTime @default(now())
  firstSeenAt           DateTime @default(now())
  cardNames             String[] @db.VarChar(255)

  @@index([dealsCount(sort: Desc)])
  @@index([sellerName])
}

model MarketSnapshot {
  id                String   @id @default(uuid()) @db.Uuid
  cardName          String   @db.VarChar(255)
  set               String?  @db.VarChar(100)
  baselinePrice     Decimal  @db.Decimal(10, 2)
  sampleSize        Int      @db.SmallInt
  recencyScore      Decimal? @db.Decimal(5, 2)
  source            String   @default("search") @db.VarChar(50)
  capturedAt        DateTime @default(now())

  @@index([cardName, capturedAt])
  @@index([capturedAt])
}

model TypoPattern {
  id                 String       @id @default(uuid()) @db.Uuid
  correctSpelling    String       @db.VarChar(255)
  commonMisspelling  String       @unique @db.VarChar(255)
  category           TypoCategory?
  levenshteinDistance Int          @db.SmallInt
  createdAt          DateTime     @default(now())

  @@index([correctSpelling])
}

model BackgroundJobLog {
  id             String        @id @default(uuid()) @db.Uuid
  searchQueryId  String        @db.Uuid
  jobType        JobType
  executedAt     DateTime      @default(now())
  completedAt    DateTime?
  status         JobStatus     @default(pending)
  listingsFound  Int?
  errorMessage   String?       @db.Text
  retryCount     Int           @default(0)
  searchQuery    SearchQuery   @relation(fields: [searchQueryId], references: [id], onDelete: Cascade)

  @@index([searchQueryId])
  @@index([status])
}

model SetCard {
  id             String          @id @default(uuid()) @db.Uuid
  setCode        String          @db.VarChar(20)
  cardNumber     String          @db.VarChar(10)
  cardName       String          @db.VarChar(255)
  rarity         String          @db.VarChar(50)
  imageSmall     String?         @db.Text
  imageLarge     String?         @db.Text
  marketPrice    Decimal?        @db.Decimal(10, 2)
  priceLow       Decimal?        @db.Decimal(10, 2)
  priceHigh      Decimal?        @db.Decimal(10, 2)
  priceVariant   String?         @db.VarChar(50)
  types          String[]        @db.VarChar(50)
  supertype      String?         @db.VarChar(50)
  subtypes       String[]        @db.VarChar(50)
  hp             String?         @db.VarChar(10)
  fetchedAt      DateTime        @default(now())
  priceUpdatedAt DateTime        @default(now())
  chaseListCards ChaseListCard[]

  @@unique([setCode, cardNumber])
  @@index([setCode])
}

model ChaseList {
  id                    String          @id @default(uuid()) @db.Uuid
  userId                String          @db.Uuid
  setCode               String          @db.VarChar(20)
  alertMinPercent       Decimal         @default(10) @db.Decimal(5, 2)
  alertMaxPrice         Decimal?        @db.Decimal(10, 2)
  alertCooldownMinutes  Int             @default(60)
  scanEnabled           Boolean         @default(true)
  lastScannedAt         DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards                 ChaseListCard[]

  @@unique([userId, setCode])
  @@index([userId])
  @@index([scanEnabled])
}

model ChaseListCard {
  id                      String          @id @default(uuid()) @db.Uuid
  chaseListId             String          @db.Uuid
  setCardId               String          @db.Uuid
  status                  ChaseCardStatus @default(needed)
  maxPriceOverride        Decimal?        @db.Decimal(10, 2)
  bestDealUrl             String?
  bestDealPrice           Decimal?        @db.Decimal(10, 2)
  bestDealScore           Int?            @db.SmallInt
  bestDealTitle           String?
  bestDealBuyingOption    String?         @db.VarChar(20)
  bestDealBidCount        Int?            @db.SmallInt
  bestDealEndTime         DateTime?
  bestDealSellerName      String?         @db.VarChar(100)
  bestDealSellerFeedback  Decimal?        @db.Decimal(5, 2)
  bestDealHasTypo         Boolean?
  lastAlertedAt           DateTime?
  addedAt                 DateTime        @default(now())
  chaseList               ChaseList       @relation(fields: [chaseListId], references: [id], onDelete: Cascade)
  setCard                 SetCard         @relation(fields: [setCardId], references: [id], onDelete: Cascade)

  @@unique([chaseListId, setCardId])
  @@index([chaseListId])
  @@index([status])
}

model SnipeAlert {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @db.Uuid
  name                String        @db.VarChar(255)
  alertType           AlertType
  sets                String[]      @db.VarChar(100)
  cardNames           String[]      @db.VarChar(255)
  maxHoursRemaining   Int?          @db.SmallInt
  maxBids             Int?          @db.SmallInt
  minPriceGapPercent  Decimal?      @db.Decimal(5, 2)
  maxPriceDollars     Decimal?      @db.Decimal(10, 2)
  minDealScore        Int?          @db.SmallInt
  enabled             Boolean       @default(true)
  cooldownMinutes     Int           @default(60)
  lastTriggeredAt     DateTime?
  createdAt           DateTime      @default(now())
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertHistory        AlertHistory[]

  @@index([userId])
  @@index([enabled])
}

model AlertHistory {
  id             String      @id @default(uuid()) @db.Uuid
  snipeAlertId   String      @db.Uuid
  ebayListingId  String
  cardName       String      @db.VarChar(255)
  listingTitle   String      @db.VarChar(500)
  price          Decimal     @db.Decimal(10, 2)
  marketPrice    Decimal?    @db.Decimal(10, 2)
  priceGapPercent Decimal?   @db.Decimal(10, 2)
  listingUrl     String
  triggeredAt    DateTime    @default(now())
  emailSent      Boolean     @default(false)
  snipeAlert     SnipeAlert  @relation(fields: [snipeAlertId], references: [id], onDelete: Cascade)

  @@index([snipeAlertId])
  @@index([ebayListingId])
  @@index([triggeredAt])
}

enum ChaseCardStatus {
  needed
  dealFound
  purchased
}

enum Rarity {
  common
  uncommon
  rare
  holoRare
  ultraRare
  illustrationRare
  specialIllustrationRare
  megaIllustrationRare
  other
}

enum Condition {
  mint
  nearMint
  excellent
  good
  fair
  poor
}

enum SearchFrequency {
  manual
  hourly
  fourHourly
  daily
  weekly
}

enum BuyingOption {
  FIXED_PRICE
  AUCTION
}

enum ListingStatus {
  active
  sold
  delisted
}

enum TypoCategory {
  cardName
  setName
  rarity
  condition
}

enum JobType {
  eBaySearch
  PriceBaseline
  SavedDealsMonitoring
  ChaseListScan
  AlertCheck
}

enum AlertType {
  AUCTION_ENDING
  BIN_DEAL
}

enum JobStatus {
  pending
  running
  completed
  failed
  skipped
}
