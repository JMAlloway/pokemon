generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  username     String         @unique @db.VarChar(100)
  email        String         @unique
  password     String
  createdAt    DateTime       @default(now())
  lastActiveAt DateTime       @default(now())
  savedListings SavedListing[]
  searchQueries SearchQuery[]
  chaseLists    ChaseList[]
}

model SearchQuery {
  id                    String          @id @default(uuid()) @db.Uuid
  userId                String          @db.Uuid
  cardName              String          @db.VarChar(255)
  set                   String?         @db.VarChar(100)
  rarity                Rarity?
  condition             Condition?
  searchFrequency       SearchFrequency @default(manual)
  priceThresholdPercent Decimal?        @db.Decimal(5, 2)
  recencyScoringEnabled Boolean         @default(true)
  lastExecutedAt        DateTime?
  createdAt             DateTime        @default(now())
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebayListings          EbayListing[]
  backgroundJobLogs     BackgroundJobLog[]

  @@index([userId])
  @@index([searchFrequency])
}

model EbayListing {
  id                  String        @id @default(uuid()) @db.Uuid
  ebayListingId       String        @unique
  searchQueryId       String        @db.Uuid
  cardName            String        @db.VarChar(255)
  listingTitle        String        @db.VarChar(500)
  currentPrice        Decimal       @db.Decimal(10, 2)
  recentSoldPrice     Decimal?      @db.Decimal(10, 2)
  priceGapPercent     Decimal?      @db.Decimal(6, 2)
  hasTypo             Boolean       @default(false)
  typoDetails         String?       @db.Text
  typoConfidenceScore Decimal?      @db.Decimal(5, 2)
  dealScore           Int?          @db.SmallInt
  recencyScore        Decimal?      @db.Decimal(5, 2)
  sellerName          String?       @db.VarChar(255)
  sellerRating        Decimal?      @db.Decimal(3, 1)
  sellerFeedbackPercent Decimal?    @db.Decimal(5, 2)
  listingUrl          String
  images              String[]
  description         String?       @db.Text
  condition           String?       @db.VarChar(50)
  buyingOption        BuyingOption  @default(FIXED_PRICE)
  bidCount            Int?          @db.SmallInt
  currentBidPrice     Decimal?      @db.Decimal(10, 2)
  auctionEndDate      DateTime?
  shippingCost        Decimal?      @db.Decimal(10, 2)
  shippingEstimated   Boolean       @default(false)
  listingStatus       ListingStatus @default(active)
  createdAt           DateTime      @default(now())
  lastCheckedAt       DateTime      @default(now())
  soldAt              DateTime?
  searchQuery         SearchQuery   @relation(fields: [searchQueryId], references: [id], onDelete: Cascade)
  savedListing        SavedListing?

  @@index([searchQueryId])
  @@index([ebayListingId])
  @@index([listingStatus])
  @@index([dealScore(sort: Desc)])
  @@index([buyingOption])
}

model SavedListing {
  id                   String        @id @default(uuid()) @db.Uuid
  userId               String        @db.Uuid
  ebayListingId        String        @unique
  priceAtSave          Decimal       @db.Decimal(10, 2)
  recentSoldPriceAtSave Decimal?     @db.Decimal(10, 2)
  dealScoreAtSave      Int?          @db.SmallInt
  savedAt              DateTime      @default(now())
  currentPrice         Decimal?      @db.Decimal(10, 2)
  priceChangePercent   Decimal?      @db.Decimal(6, 2)
  status               ListingStatus @default(active)
  lastPriceCheckAt     DateTime?
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebayListing          EbayListing   @relation(fields: [ebayListingId], references: [ebayListingId], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model RecentSoldListing {
  id            String   @id @default(uuid()) @db.Uuid
  cardName      String   @db.VarChar(255)
  set           String?  @db.VarChar(100)
  rarity        String?  @db.VarChar(50)
  condition     String?  @db.VarChar(50)
  soldPrice     Decimal  @db.Decimal(10, 2)
  shippingCost  Decimal? @db.Decimal(10, 2)
  soldAt        DateTime
  daysOld       Int?     @db.SmallInt
  source        String   @default("eBay") @db.VarChar(50)
  lastUpdatedAt DateTime @default(now())

  @@index([cardName])
  @@index([soldAt])
}

model TypoPattern {
  id                 String       @id @default(uuid()) @db.Uuid
  correctSpelling    String       @db.VarChar(255)
  commonMisspelling  String       @unique @db.VarChar(255)
  category           TypoCategory?
  levenshteinDistance Int          @db.SmallInt
  createdAt          DateTime     @default(now())

  @@index([correctSpelling])
}

model BackgroundJobLog {
  id             String        @id @default(uuid()) @db.Uuid
  searchQueryId  String        @db.Uuid
  jobType        JobType
  executedAt     DateTime      @default(now())
  completedAt    DateTime?
  status         JobStatus     @default(pending)
  listingsFound  Int?
  errorMessage   String?       @db.Text
  retryCount     Int           @default(0)
  searchQuery    SearchQuery   @relation(fields: [searchQueryId], references: [id], onDelete: Cascade)

  @@index([searchQueryId])
  @@index([status])
}

model SetCard {
  id            String          @id @default(uuid()) @db.Uuid
  setName       String          @db.VarChar(100)
  cardNumber    String          @db.VarChar(20)
  cardName      String          @db.VarChar(255)
  rarity        String?         @db.VarChar(50)
  cardType      String?         @db.VarChar(50)
  imageUrl      String?
  marketPrice   Decimal?        @db.Decimal(10, 2)
  lastPriceUpdate DateTime?
  createdAt     DateTime        @default(now())
  chaseListCards ChaseListCard[]

  @@unique([setName, cardNumber])
  @@index([setName])
}

model ChaseList {
  id                    String          @id @default(uuid()) @db.Uuid
  userId                String          @db.Uuid
  setName               String          @db.VarChar(100)
  alertMinPercent       Decimal         @default(10) @db.Decimal(5, 2)
  alertMaxPrice         Decimal?        @db.Decimal(10, 2)
  alertCooldownMinutes  Int             @default(60)
  scanEnabled           Boolean         @default(true)
  lastScannedAt         DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards                 ChaseListCard[]

  @@unique([userId, setName])
  @@index([userId])
  @@index([scanEnabled])
}

model ChaseListCard {
  id             String          @id @default(uuid()) @db.Uuid
  chaseListId    String          @db.Uuid
  setCardId      String          @db.Uuid
  status         ChaseCardStatus @default(needed)
  maxPriceOverride Decimal?      @db.Decimal(10, 2)
  bestDealUrl    String?
  bestDealPrice  Decimal?        @db.Decimal(10, 2)
  bestDealScore  Int?            @db.SmallInt
  lastAlertedAt  DateTime?
  addedAt        DateTime        @default(now())
  chaseList      ChaseList       @relation(fields: [chaseListId], references: [id], onDelete: Cascade)
  setCard        SetCard         @relation(fields: [setCardId], references: [id], onDelete: Cascade)

  @@unique([chaseListId, setCardId])
  @@index([chaseListId])
  @@index([status])
}

enum ChaseCardStatus {
  needed
  dealFound
  purchased
}

enum Rarity {
  common
  uncommon
  rare
  holoRare
  other
}

enum Condition {
  mint
  nearMint
  excellent
  good
  fair
  poor
}

enum SearchFrequency {
  manual
  hourly
  fourHourly
  daily
  weekly
}

enum BuyingOption {
  FIXED_PRICE
  AUCTION
}

enum ListingStatus {
  active
  sold
  delisted
}

enum TypoCategory {
  cardName
  setName
  rarity
  condition
}

enum JobType {
  eBaySearch
  PriceBaseline
  SavedDealsMonitoring
  ChaseListScan
}

enum JobStatus {
  pending
  running
  completed
  failed
  skipped
}
